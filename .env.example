# ---- General ----
NODE_ENV=development

# ---- API server ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# ---- PostgreSQL ----
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_password
POSTGRES_DB=vms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vms:vms_password@localhost:5432/vms?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=vms_minio
MINIO_ROOT_PASSWORD=vms_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=vms-photos
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false

# ---- Mailpit (mock email provider) ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=vms@example.com

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- QR / visit pass signing ----
QR_SIGNING_SECRET=change-me-qr-secret

# ---- Policy defaults (seeded into the Policy table, editable by admin) ----
MAX_PREAPPROVALS_PER_HOST_PER_DAY=5
OVERSTAY_MINUTES=480
PENDING_APPROVAL_TIMEOUT_MINUTES=30

# ---- Rate limiting ----
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30

# ---- Frontend (Vite, must be prefixed VITE_) ----
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
